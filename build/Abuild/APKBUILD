# Alpine-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=file
pkgver=5.46
pkgrel=1
pkgdesc="File type identification utility"
url="https://www.darwinsys.com/file/"
arch="all"
license="BSD-2-Clause"
subpackages="libmagic-static $pkgname-dev $pkgname-doc libmagic"
source="https://astron.com/pub/file/file-$pkgver.tar.gz
	file-$pkgver-pr-579-net147-fix-stack-overrun.patch
"

build() {
	LDFLAGS="-lregex" ./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--datadir=/usr/share \
		--enable-static
	make
}

check() {
	make check
}

package() {
    depends="libmagic"
    make DESTDIR="$pkgdir" install
}

libmagic() {
	pkgdesc="File type identification library"

	amove \
		usr/lib/libmagic.so.* \
		usr/share/misc/magic.mgc
}


